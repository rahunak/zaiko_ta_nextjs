# Шаблон переменных для служебного раздела /admin.
# Скопируйте в .env.local (Next.js) и, при необходимости, в .env (docker compose)
# и подставьте свои значения. Файлы .env* в репозиторий не попадают.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=zaiko_admin
POSTGRES_USER=zaiko
POSTGRES_PASSWORD=zaiko_dev_password
# Строка подключения для приложения и скрипта db:init
DATABASE_URL=postgres://zaiko:zaiko_dev_password@127.0.0.1:5434/zaiko_admin
# Размер пула соединений на процесс (по умолчанию 3). Для serverless ставьте 1–2.
PG_POOL_MAX=

# --- Первый администратор (используется только скриптом bun run db:init) ---
# Пароль хранится в БД как scrypt-хэш. После db:init эту переменную можно убрать.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-before-db-init

# --- api-anything (локальный HTTP-сервер операций) ---
# Запуск: npx -y api-anything@0.4.0 serve (токен лежит в ~/.api-anything/serve-token)
API_ANYTHING_URL=http://127.0.0.1:8787
API_ANYTHING_TOKEN=

# --- DIKIDI: чтение журнала записей через api-anything ---
DIKIDI_COMPANY_ID=1784388
DIKIDI_MASTER_ID=3834316
DIKIDI_API_SITE=dikidi
DIKIDI_JOURNAL_OP=journal
# JSON-шаблон аргументов операции: {company}, {master}, {from}, {to} подставляются в рантайме.
DIKIDI_JOURNAL_ARGS={"company":"{company}","from":"{from}","to":"{to}"}

# --- DIKIDI: транспорт (api-anything — локальная разработка, http — прод) ---
# http          — прямые запросы к dikidi.net; нужен токен или пара логин/пароль
# api-anything  — операции через локальный сервис api-anything
# не задана    — авто: http при наличии токена/кредов, иначе api-anything
DIKIDI_TRANSPORT=
# Cookie token кабинета DIKIDI (ручной вариант). После автологина хранится в таблице dikidi_auth.
DIKIDI_TOKEN=
# Cookie-заголовок кабинета DIKIDI целиком вместо автопрогрева, например «gws=…; PHPSESSID=…».
# Нужен, если автологин упирается в SMS-код или капчу.
DIKIDI_COOKIES=
# Автологин в кабинет: телефон владельца кабинета и пароль.
DIKIDI_LOGIN=
DIKIDI_PASSWORD=
# Адрес DIKIDI, по умолчанию https://dikidi.net (переопределяется для тестового стенда/моков).
DIKIDI_BASE_URL=

# --- Telegram: два отдельных бота ---
# 1) Админский бот (zaiko_ta_admin_bot) — только пишет мастеру. Вебхук ему НЕ нужен:
#    достаточно, чтобы мастер один раз нажал /start у него.
TELEGRAM_BOT_TOKEN=
# chat_id ЛИЧНОГО чата мастера с админским ботом: число, не @username канала.
# Несколько получателей — через запятую. Узнать chat_id: написать боту @userinfobot.
# Мастер должен сам нажать /start — писать первым бот не может (иначе «chat not found»).
TELEGRAM_MASTER_CHAT_ID=

# 2) Бот напоминаний клиентам (zaiko_ta_bot) — на него подписываются клиенты.
# На него ставится вебхук /api/telegram/webhook; он же отправляет напоминания клиентам.
# Если не задан, клиентские напоминания уйдут от админского бота — такой клиент
# его не запускал, и Telegram ответит «chat not found».
TELEGRAM_CLIENT_BOT_TOKEN=
# Имя клиентского бота без @ — из него собирается кнопка на /book:
# https://t.me/<имя>?start=<token>. По умолчанию код подставляет zaiko_ta_bot.
TELEGRAM_CLIENT_BOT_USERNAME=

# Legacy: общие имена на случай одного бота на всё. Читаются, только если
# TELEGRAM_CLIENT_BOT_* не заданы.
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Секрет вебхука клиентского бота: передаётся в setWebhook как secret_token и
# проверяется в /api/telegram/webhook по заголовку x-telegram-bot-api-secret-token.
# Без него вебхук принимает запросы от кого угодно. Необязательно, но рекомендуется.
TELEGRAM_CLIENT_WEBHOOK_SECRET=

# Секрет для /api/cron/reminders (заголовок Authorization: Bearer <секрет>).
# Без него эндпоинт отвечает 503. На Vercel встроенный планировщик не работает,
# поэтому напоминания приходят только по cron-вызову этого эндпоинта.
CRON_SECRET=

# --- Supabase (опционально: если БД перенесена в Supabase) ---
# Достаточно DATABASE_URL — строки подключения Supabase (pooler для рантайма).
# SUPABASE_* ключи нужны только при использовании Supabase SDK/Auth — сейчас не используются.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
# Порт обязателен 6543 (transaction pooler): session pooler 5432 даёт ~15 соединений и падает с EMAXCONNSESSION.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# SUPABASE_JWKS_URL=
