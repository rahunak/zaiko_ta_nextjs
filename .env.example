# Шаблон переменных для служебного раздела /admin.
# Скопируйте в .env.local (Next.js) и, при необходимости, в .env (docker compose)
# и подставьте свои значения. Файлы .env* в репозиторий не попадают.

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=zaiko_admin
POSTGRES_USER=zaiko
POSTGRES_PASSWORD=zaiko_dev_password
# Строка подключения для приложения и скрипта db:init
DATABASE_URL=postgres://zaiko:zaiko_dev_password@127.0.0.1:5434/zaiko_admin

# --- Первый администратор (используется только скриптом bun run db:init) ---
# Пароль хранится в БД как scrypt-хэш. После db:init эту переменную можно убрать.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=change-me-before-db-init

# --- api-anything (локальный HTTP-сервер операций) ---
# Запуск: npx -y api-anything@0.4.0 serve (токен лежит в ~/.api-anything/serve-token)
API_ANYTHING_URL=http://127.0.0.1:8787
API_ANYTHING_TOKEN=

# --- DIKIDI: чтение журнала записей через api-anything ---
DIKIDI_COMPANY_ID=1784388
DIKIDI_MASTER_ID=3834316
DIKIDI_API_SITE=dikidi
DIKIDI_JOURNAL_OP=journal
# JSON-шаблон аргументов операции: {company}, {master}, {from}, {to} подставляются в рантайме.
DIKIDI_JOURNAL_ARGS={"company":"{company}","from":"{from}","to":"{to}"}

# --- DIKIDI: отправка созданной записи (write-операция), по умолчанию выключена ---
# Заполняется после того, как write-операция обучена: api-anything add ... --write
DIKIDI_WRITE_OP=
DIKIDI_WRITE_ARGS=
